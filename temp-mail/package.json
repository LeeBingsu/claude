{
  "name": "temp-mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute temp-mail --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute temp-mail --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "send-test": "node scripts/send-test-email.mjs"
  },
  "dependencies": {
    "postal-mime": "^2.7.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260808.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
