<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The whole UI is Jetpack Compose (see MainActivity + AppTheme.kt), so
        this only needs to supply a safe window background before Compose
        takes over and a splash-less launch theme.
    -->
    <style name="Theme.MdFileEditor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
